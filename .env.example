# Configuration Supabase (identifiants du projet)
# À copier dans un fichier .env.local avec vos vraies valeurs
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# La clé publique (nommée "Publishable key" dans la nouvelle interface Supabase ou "anon key") :
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publique
# NEXT_PUBLIC_SUPABASE_ANON_KEY est également supportée pour la rétrocompatibilité
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique